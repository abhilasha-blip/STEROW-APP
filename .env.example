# Copy to .env.development / .env.staging / .env.production and fill in.
# Debug builds read .env.development, Release builds read .env.production
# (iOS: ios/Podfile post_install, Android: android/app/build.gradle envConfigFiles).
APP_API_BASE_URL=https://example.com/api/public/v1
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
# Dev only: number used by scripts/smoke-auth.ts. 10 digits, no +91.
TEST_PHONE=
# Dev only: fixed OTP of the backend test login (smoke script only, never app code).
TEST_OTP=
